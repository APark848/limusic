{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ios-main",
  "description": "Enables the permissions used by the main iOS WebView",
  "windows": [
    "main"
  ],
  "platforms": [
    "iOS"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text"
  ]
}
